* text=auto

# Linux/ROS files must keep LF when cloned by Git for Windows.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.world text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf

# Native Windows launchers use CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

# Documentation remains stable across platforms.
*.md text eol=lf
*.txt text eol=crlf
