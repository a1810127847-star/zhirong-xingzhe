<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zhirong_diffbot">
  <xacro:property name="base_length" value="0.42"/>
  <xacro:property name="base_width" value="0.30"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass" value="8.0"/>

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_base" value="0.28"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <!-- Calibrated drive separation compensates the angular-speed loss caused
       by four-wheel lateral scrub; physical joint spacing remains 0.34 m. -->
  <xacro:property name="drive_wheel_separation" value="0.40"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <xacro:property name="lidar_radius" value="0.055"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.25"/>

  <xacro:property name="camera_length" value="0.055"/>
  <xacro:property name="camera_width" value="0.10"/>
  <xacro:property name="camera_height" value="0.045"/>
  <xacro:property name="camera_mass" value="0.18"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="position x_offset y_offset">
    <link name="${position}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.08 0.08 0.09 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0.0"
          izz="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${position}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${position}_wheel_link"/>
      <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <gazebo reference="${position}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <!-- Keep strong rolling traction but allow controlled lateral scrub.
           Four rigid wheels with isotropic friction fight each other during
           skid-steer turns, which causes chassis drift and visible jitter. -->
      <fdir1>1 0 0</fdir1>
      <mu1>1.0</mu1>
      <mu2>0.10</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.08 0.36 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:wheel
    position="front_left"
    x_offset="${wheel_base / 2.0}"
    y_offset="${wheel_separation / 2.0}"/>
  <xacro:wheel
    position="front_right"
    x_offset="${wheel_base / 2.0}"
    y_offset="${-wheel_separation / 2.0}"/>
  <xacro:wheel
    position="rear_left"
    x_offset="${-wheel_base / 2.0}"
    y_offset="${wheel_separation / 2.0}"/>
  <xacro:wheel
    position="rear_right"
    x_offset="${-wheel_base / 2.0}"
    y_offset="${-wheel_separation / 2.0}"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_red">
        <color rgba="0.85 0.08 0.06 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${lidar_mass * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height) / 12.0}"
        iyz="0.0"
        izz="${lidar_mass * lidar_radius * lidar_radius / 2.0}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.145" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor name="lidar_sensor" type="ray">
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1.0</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="zhirong_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="camera_green">
        <color rgba="0.05 0.58 0.30 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <inertia
        ixx="${camera_mass * (camera_width * camera_width + camera_height * camera_height) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${camera_mass * (camera_length * camera_length + camera_height * camera_height) / 12.0}"
        iyz="0.0"
        izz="${camera_mass * (camera_length * camera_length + camera_width * camera_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.19 0 0.115" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin
      xyz="${camera_length / 2.0} 0 0"
      rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Green</material>
    <sensor name="rgbd_sensor" type="depth">
      <visualize>false</visualize>
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <pose>${camera_length / 2.0} 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.2217304764</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <depth_camera/>
        <clip>
          <near>0.15</near>
          <far>8.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
      </camera>
      <plugin name="zhirong_rgbd_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>rgbd/image_raw:=color/image_raw</remapping>
          <remapping>rgbd/camera_info:=color/camera_info</remapping>
          <remapping>rgbd/depth/image_raw:=depth/image_raw</remapping>
          <remapping>rgbd/depth/camera_info:=depth/camera_info</remapping>
          <remapping>rgbd/points:=depth/points</remapping>
        </ros>
        <camera_name>rgbd</camera_name>
        <frame_name>camera_optical_link</frame_name>
        <min_depth>0.15</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="zhirong_skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_safe</remapping>
      </ros>
      <update_rate>50.0</update_rate>

      <num_wheel_pairs>2</num_wheel_pairs>

      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${drive_wheel_separation}</wheel_separation>
      <wheel_separation>${drive_wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>6.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
