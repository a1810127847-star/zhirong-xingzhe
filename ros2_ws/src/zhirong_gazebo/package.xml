<?xml version="1.0"?>
<package format="3">
  <name>zhirong_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo worlds for the Zhirong robot simulation.</description>
  <maintainer email="maintainer@example.com">Zhirong Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
